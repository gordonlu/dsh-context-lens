{
  "name": "dsh-context-lens",
  "version": "0.2.2",
  "description": "Request Context Profiler for DeepSeek Harness — see what changed between model requests, and how cache reuse changed with it.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gordonlu/dsh-context-lens.git"
  },
  "bugs": {
    "url": "https://github.com/gordonlu/dsh-context-lens/issues"
  },
  "homepage": "https://github.com/gordonlu/dsh-context-lens#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "context-engineering",
    "llm-observability",
    "agent-observability",
    "cache-reuse"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "IMPLEMENTATION_NOTES.md",
    "LICENSE"
  ],
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-brand": "file:./vendor-stubs/dsh-brand",
    "@deepseek-ai/dsh-client-locale": "file:./vendor-stubs/dsh-client-locale",
    "@deepseek-ai/dsh-client-runtime": "file:./vendor-stubs/dsh-client-runtime",
    "@deepseek-ai/dsh-client-ui-conversation": "file:./vendor-stubs/dsh-client-ui-conversation",
    "@deepseek-ai/dsh-client-ui-slots": "file:./vendor-stubs/dsh-client-ui-slots",
    "@deepseek-ai/dsh-invariants": "file:./vendor-stubs/dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:./vendor-stubs/dsh-llm",
    "@deepseek-ai/dsh-session": "file:./vendor-stubs/dsh-session",
    "@deepseek-ai/dsh-session-projection": "file:./vendor-stubs/dsh-session-projection",
    "@types/node": "^24.10.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  }
}
